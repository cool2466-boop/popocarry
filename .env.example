# Required. Generate a random secret (32+ characters); do not commit .env.local.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
DATABASE_URL="file:./dev.db"
# Only test keys are accepted by the current payment implementation.
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=
